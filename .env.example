# Local MS Access database (stays on the office machine)
ACCESS_DB_PATH=C:\OmSree\data\db tables.accdb
# Database open password (the OmSree .accdb files are password-protected).
# Leave blank if the file has no password.
ACCESS_DB_PASSWORD=

# OmSree CRM web app
CRM_BASE_URL=https://crm.example.com
AGENT_TOKEN=replace-with-issued-token

# Where the agent writes last-sync.json and sync.log (defaults to the cwd)
STATE_DIR=

# Sync behaviour
SYNC_INTERVAL_MINUTES=15
DRY_RUN=true

# Real OmSree tables to sync (web -> Access). See docs/sync-contract.md.
TABLE_WHITELIST=tbl_Property,tbl_Block,tbl_PropertyBlock,tbl_Property_Status,tbl_Property_Type,tbl_Customer,tbl_Property_Details,tbl_PropertyDetailsPaymentSchedule,tbl_Other_Charges_Receipts,tbl_DocumentRecord
